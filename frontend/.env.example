# ===========================================
# 前端环境变量配置模板
# ===========================================
# 使用方法：复制此文件为 .env.local 并填入真实值
# .env.local 已被 .gitignore 忽略，不会提交到仓库

# API 基础地址（开发环境通过 vue.config.js 代理到后端）
VUE_APP_BASE_API=/api

# 应用标题
VUE_APP_TITLE=运动康复医疗管理平台

# WebSocket 地址（可选）
# VUE_APP_WS_URL=ws://localhost:8082/ws
