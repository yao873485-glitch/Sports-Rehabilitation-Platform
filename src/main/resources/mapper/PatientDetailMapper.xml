<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rehabilitation.mapper.PatientDetailMapper">

    <resultMap id="BaseResultMap" type="com.rehabilitation.entity.PatientDetail">
        <id column="id" property="id"/>
        <result column="patient_id" property="patientId"/>
        <result column="nickname" property="nickname"/>
        <result column="id_card_type" property="idCardType"/>
        <result column="height_cm" property="heightCm"/>
        <result column="ethnicity" property="ethnicity"/>
        <result column="occupation" property="occupation"/>
        <result column="contact_province_city_district" property="contactProvinceCityDistrict"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <select id="selectByPatientId" resultMap="BaseResultMap">
        SELECT * FROM patient_detail WHERE patient_id = #{patientId}
    </select>

</mapper>