<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rehabilitation.mapper.FollowupProgramMasterMapper">

    <!-- 结果映射 -->
    <resultMap id="FollowupProgramVOMap" type="com.rehabilitation.dto.FollowupProgramVO">
        <id column="id" property="id"/>
        <result column="project_code" property="projectCode"/>
        <result column="project_name" property="projectName"/>
        <result column="project_description" property="projectDescription"/>
        <result column="linked_followup_plan" property="linkedFollowupPlan"/>
        <result column="last_modified_time" property="lastModifiedTime"/>
        <result column="created_time" property="createdTime"/>
        <result column="operator" property="operator"/>
        <result column="is_published" property="isPublished"/>
    </resultMap>

    <!-- 分页查询随访项目 -->
    <select id="selectFollowupProgramPage" resultMap="FollowupProgramVOMap">
        SELECT
            id,
            project_code,
            project_name,
            project_description,
            linked_followup_plan,
            last_modified_time,
            created_time,
            operator,
            is_published
        FROM followup_program_master
        <where>
            <if test="dto.projectName != null and dto.projectName != ''">
                AND project_name LIKE CONCAT('%', #{dto.projectName}, '%')
            </if>
            <if test="dto.isPublished != null">
                AND is_published = #{dto.isPublished}
            </if>
            <if test="dto.startDate != null and dto.startDate != ''">
                AND DATE(created_time) >= #{dto.startDate}
            </if>
            <if test="dto.endDate != null and dto.endDate != ''">
                AND DATE(created_time) &lt;= #{dto.endDate}
            </if>
        </where>
        ORDER BY created_time DESC
    </select>

    <!-- 根据ID查询随访项目详情 -->
    <select id="selectFollowupProgramById" resultMap="FollowupProgramVOMap">
        SELECT
            id,
            project_code,
            project_name,
            project_description,
            linked_followup_plan,
            last_modified_time,
            created_time,
            operator,
            is_published
        FROM followup_program_master
        WHERE id = #{id}
    </select>

</mapper>