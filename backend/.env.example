# ===========================================
# 后端环境变量配置模板
# ===========================================
# 使用方法：
#   方式1：在 IDE 中设置运行环境变量
#   方式2：通过命令行 -D 参数传入
#   方式3：创建 application-local.yml（已被 .gitignore 忽略）
#
# 生产环境请务必修改以下所有默认值！

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sports_rehabilitation
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置（生产环境请使用随机生成的强密钥）
JWT_SECRET=your_jwt_secret_here_change_me

# 阿里云OSS配置（如需使用图片上传功能）
OSS_ACCESS_KEY_ID=your_aliyun_access_key_id
OSS_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=sports-rehabilitation
