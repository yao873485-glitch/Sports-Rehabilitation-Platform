<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rehabilitation.mapper.PatientSchemeInfoMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.rehabilitation.entity.PatientSchemeInfo">
        <id column="id" property="id"/>
        <result column="patient_id" property="patientId"/>
        <result column="patient_name" property="patientName"/>
        <result column="gender" property="gender"/>
        <result column="birth_date" property="birthDate"/>
        <result column="medical_record_no" property="medicalRecordNo"/>
        <result column="scheme_id" property="schemeId"/>
        <result column="disease_type" property="diseaseType"/>
        <result column="status" property="status"/>
        <result column="org_name" property="orgName"/>
        <result column="create_time" property="createTime"/>
        <result column="end_time" property="endTime"/>
    </resultMap>

    <!-- 分页查询患者方案信息列表 -->
    <select id="selectPatientSchemeInfoPage" resultMap="BaseResultMap">
        SELECT
            psi.id,
            psi.patient_id,
            p.name AS patient_name,
            p.gender,
            p.birth_date,
            p.medical_record_no,
            psi.scheme_id,
            p.disease_type,
            psi.status,
            p.enrollment_institution AS org_name,
            psi.create_time,
            psi.end_time
        FROM patient_scheme_info psi
        LEFT JOIN patient p ON psi.patient_id = p.id
        <where>
            <if test="query.startTime != null and query.endTime != null">
                AND psi.create_time BETWEEN #{query.startTime} AND #{query.endTime}
            </if>
            <if test="query.diseaseType != null and query.diseaseType != ''">
                AND p.disease_type = #{query.diseaseType}
            </if>
            <if test="query.searchKeyword != null and query.searchKeyword != ''">
                AND (p.name LIKE CONCAT('%', #{query.searchKeyword}, '%')
                OR p.medical_record_no LIKE CONCAT('%', #{query.searchKeyword}, '%'))
            </if>
            <if test="query.orgName != null and query.orgName != ''">
                AND p.enrollment_institution = #{query.orgName}
            </if>
            <if test="query.status != null">
                AND psi.status = #{query.status}
            </if>
        </where>
        ORDER BY psi.create_time DESC
    </select>

</mapper>
