<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rehabilitation.mapper.SchemeCycleConfigMapper">

    <resultMap id="BaseResultMap" type="com.rehabilitation.entity.SchemeCycleConfig">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="patient_id" property="patientId" jdbcType="INTEGER"/>
        <result column="scheme_id" property="schemeId" jdbcType="VARCHAR"/>
        <result column="cycle_months" property="cycleMonths" jdbcType="INTEGER"/>
        <result column="start_date" property="startDate" jdbcType="DATE"/>
        <result column="end_date" property="endDate" jdbcType="DATE"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="created_by" property="createdBy" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
        <result column="remarks" property="remarks" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 根据患者ID查询方案周期配置 -->
    <select id="selectByPatientId" resultMap="BaseResultMap">
        SELECT * FROM scheme_cycle_config
        WHERE patient_id = #{patientId}
        AND status = 1
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <!-- 根据患者ID和方案ID查询方案周期配置 -->
    <select id="selectByPatientIdAndSchemeId" resultMap="BaseResultMap">
        SELECT * FROM scheme_cycle_config
        WHERE patient_id = #{patientId}
        <if test="schemeId != null and schemeId != ''">
            AND scheme_id = #{schemeId}
        </if>
        <if test="schemeId == null or schemeId == ''">
            AND scheme_id IS NULL
        </if>
        AND status = 1
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <!-- 根据患者ID删除方案周期配置 -->
    <delete id="deleteByPatientId">
        DELETE FROM scheme_cycle_config WHERE patient_id = #{patientId}
    </delete>

    <!-- 根据方案ID查询方案周期配置 -->
    <select id="selectBySchemeId" resultMap="BaseResultMap">
        SELECT * FROM scheme_cycle_config
        WHERE scheme_id = #{schemeId}
        AND status = 1
        ORDER BY created_at DESC
        LIMIT 1
    </select>

</mapper>
